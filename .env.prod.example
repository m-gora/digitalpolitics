# GHCR image names (lowercase); the app tag is advanced by the deploy receiver.
DPP_IMAGE=ghcr.io/your-owner/digital-politics-platform
DPP_TAG=v0.1.0
UPDATER_IMAGE=ghcr.io/your-owner/digital-politics-platform-updater
UPDATER_TAG=v0.1.0

# Public hostname and OAuth2 Proxy / OIDC configuration.
DOMAIN=example.org
AUTH0_DOMAIN=your-tenant.example.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-secret

# App and database configuration.
APP_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://dpp:replace-me@db:5432/dpp
POSTGRES_DB=dpp
POSTGRES_USER=dpp
POSTGRES_PASSWORD=replace-me
AI_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=
GOOGLE_TEXT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# A random webhook bearer token and read-only GHCR credentials (leave the latter
# empty if the application package is public).
DEPLOY_TOKEN=replace-with-a-long-random-token
GHCR_USERNAME=your-github-username
GHCR_TOKEN=read-packages-token
